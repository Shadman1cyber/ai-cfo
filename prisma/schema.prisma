generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(191)
  email         String    @unique @db.VarChar(191)
  emailVerified DateTime?
  passwordHash  String?   @db.VarChar(191)
  image         String?   @db.VarChar(191)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  categories    Category[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.VarChar(100)
  type              String  @db.VarChar(191)
  provider          String  @db.VarChar(100)
  providerAccountId String  @db.VarChar(100)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(191)
  scope             String? @db.VarChar(191)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(191)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(191)
  userId       String   @db.VarChar(100)
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String @db.VarChar(100)
  token      String @unique @db.VarChar(100)
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(100)
  nameFa       String        @db.VarChar(191)
  icon         String?       @db.VarChar(191)
  color        String?       @db.VarChar(191)
  type         TransactionType
  isDefault    Boolean       @default(false)
  userId       String?       @db.VarChar(100)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name, userId])
  @@index([userId])
}

model Transaction {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(19, 4)
  type        TransactionType
  description String?       @db.VarChar(191)
  date        DateTime      @default(now())
  receiptUrl  String?
  userId      String        @db.VarChar(100)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?       @db.VarChar(100)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, type])
}

enum TransactionType {
  INCOME
  EXPENSE
}